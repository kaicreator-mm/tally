# =============================================================================
# Tally 仓库 .gitignore
#
# 项目结构事实:
#   - Go 控制面:cmd/{server,worker,tally} + internal/** + test/**;
#     web/ 为 Go template + HTMX,静态资源内嵌二进制,无前端构建管线,全部入库。
#   - 构建产物:make build 统一输出到 bin/。
#   - 状态存储:外部 PostgreSQL,仓库内不产生任何数据库文件。
#   - 本地工具目录:.codegraph / .codex / .worktrees。
# 原则:只忽略「本地生成物、本地工具状态、机密」;
#       源码、测试夹具、迁移、文档一律随库跟踪。
# =============================================================================

# ---- 构建产物 -----------------------------------------------------------------
# make build 编译出的三个二进制(server / worker / tally;Windows 下含 .exe)。
# 锚定仓库根,避免误伤各包内合法的 bin/ 目录。
/bin/
# go build ./cmd/v15server 直接在仓库根产出的本地二进制(Windows 含 .exe)。
/v15server
/v15server.exe

# ---- 本地验证载体输出 -----------------------------------------------------------
# scripts/validate-v*.sh 的本地验证记录(命令/结果/时间戳),属本地工具状态,
# 与 .codegraph/.worktrees 同类,不随源码入库或导出。
/.local-validation/

# ---- Go 测试与性能分析产物 ------------------------------------------------------
# go test -c 编译出的测试二进制、覆盖率文件(cover profile)、pprof 输出
*.test
*.out
*.prof

# ---- 运行日志 -----------------------------------------------------------------
# 运行期日志不入库。
# 例外:internal/logpipe/testdata/ 下的 *.log 是 logpipe 解析器的测试夹具
# (模拟 compose / docker / go / npm 等真实日志输出,分布在多层子目录),
# 必须随库跟踪。注意必须用 ** 递归匹配 —— 单层 * 保护不到子目录里的夹具。
*.log
!internal/logpipe/testdata/**/*.log

# ---- 机密与本地环境变量 ---------------------------------------------------------
# 部署配置一律走环境变量(DATABASE_URL、TALLY_PASSWORD 等),.env 系列不落库;
# 末行负规则为将来公开的字段示例文件 .env.example 留出通道。
.env
.env.*
!.env.example

# ---- 本地开发辅助(每人自备,不入库)---------------------------------------------
# make dev-db 引用的本地 Postgres compose 文件;仓库有意不提供该文件,
# 由开发者按 docs/guides/deployment.md 自行准备,故不入库。
docker-compose.dev.yml

# ---- 本地工具状态 --------------------------------------------------------------
# codegraph 本地代码知识图谱索引缓存
.codegraph/
# Codex 等 agent 的本地会话/状态
.codex/
# 本地 E2E 凭据/运行态(严禁随源码导出或提交)
.e2e/
# 候选代码的一次性 Git worktree(可执行变更不发生在主工作树)
.worktrees/

# ---- 操作系统 / 编辑器杂项 ------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
