{{define "content"}}
<div class="head">
  <h1>Change 详情</h1>
  <span class="meta">immutable ChangeSet · 验证 Run / 证据 · hunk 清单 · 覆盖</span>
</div>

{{if .Unavailable}}
<div class="empty">
  v1.3 数据源未接入。
  <span class="do">本页需要事实面(数据库)与 Git 制品仓库。接好后,从这里查看不可变候选快照、其验证历史与确定性 hunk 清单。</span>
</div>
{{else if .NotFound}}
<div class="empty">没有这份 ChangeSet:<span class="dim">{{.ID}}</span>(候选身份由内容推导;请从任务页的候选链接进入)。</div>
{{else if .LoadErr}}
<div class="flash bad">读取失败:{{.LoadErr}}</div>
{{else}}

<section>
  <div class="grid grid-4">
    <div class="cell"><div class="k">ChangeSet 身份</div><div class="v" style="font-size:13px;line-height:20px;word-break:break-all">{{.ID}}</div></div>
    <div class="cell"><div class="k">项目 / 产生 Run</div><div class="v" style="font-size:13px;line-height:20px">{{.Project}}<div class="dim">run {{.ProducerRun}} · {{.CreatedAt}}</div></div></div>
    <div class="cell"><div class="k">Base revision</div><div class="v" style="font-size:13px;line-height:20px;word-break:break-all">{{.Base}}</div></div>
    <div class="cell"><div class="k">Candidate / patch 身份</div><div class="v" style="font-size:13px;line-height:20px;word-break:break-all">{{if .Candidate}}{{.Candidate}}{{end}}{{if .PatchID}}<div class="dim">patch {{.PatchID}}</div>{{end}}</div></div>
  </div>
  <p class="note">ChangeSet 是<b>不可变快照</b>(验证、评审与集成的固定单元):base/candidate/patch 身份、改动文件与产生它的 Run 在构造时固定,之后只读。取代关系是独立的 append-only 事实,见下方取代记录。</p>
  {{if .Entities}}
  <p class="note">受影响 SoftwareEntity:{{join .Entities "、 "}}</p>
  {{end}}
</section>

{{if .Superseded}}
<section>
  <h2>取代记录</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>旧候选</th><th>新候选</th><th>原因</th><th>时刻</th></tr></thead>
    <tbody>
      {{range .Superseded}}
      <tr>
        <td class="dim nowrap"><a href="/v13/changes/{{.Old}}">{{short .Old}}</a></td>
        <td class="nowrap"><a href="/v13/changes/{{.New}}">{{short .New}}</a></td>
        <td>{{.Reason}}</td>
        <td class="nowrap dim">{{.At}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  </div>
</section>
{{end}}

<section>
  <h2>Lineage 暴露(当前候选 + 取代祖先)</h2>
  <p class="note">暴露是 <b>append-only 事实</b>:held-out 内容或诊断进入实现侧可见通道即记录,取代 / 返工不重置暴露账。Lineage(候选在前,取代祖先随后):{{range $i, $id := .Lineage}}{{if $i}} · {{end}}<span class="dim nowrap">{{short $id}}</span>{{end}}</p>
  {{if .Exposures}}
  <div class="table-wrap">
  <table>
    <thead><tr><th>位置</th><th>binding / 条款</th><th>通道</th><th>作用域</th><th>时刻</th><th>追溯</th></tr></thead>
    <tbody>
      {{range .Exposures}}
      <tr>
        <td class="nowrap">{{if .Current}}<span class="st st-warn">当前候选</span>{{else}}<span class="st st-bad">祖先 · 第 {{.Depth}} 代</span> <a class="dim nowrap" href="/v13/changes/{{.Anchor}}">{{short .Anchor}}</a>{{end}}</td>
        <td>{{.BindingID}}{{if .Acceptance}} <span class="dim">({{.Acceptance}})</span>{{end}}</td>
        <td class="nowrap">{{.Channel}}</td>
        <td class="dim nowrap">{{.Scope}}</td>
        <td class="dim nowrap">{{.ExposedAt}}</td>
        <td class="dim">{{if .Reason}}{{.Reason}}{{else}}—{{end}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  </div>
  {{if .AncestorExposure}}
  <div class="flash warn">{{.AncestorExposure}} 条暴露锚定在取代祖先上:当前候选自身的记录是否干净不影响它们的存在;independence 覆盖按整条 lineage 消费这些事实(保证只降不升)。</div>
  {{end}}
  {{else}}
  <p class="note dim">该候选及其全部取代祖先上没有暴露事实。</p>
  {{end}}
</section>

<section>
  <h2>改动文件(快照固定内容)</h2>
  {{if .Files}}
  <div class="table-wrap">
  <table>
    <thead><tr><th>路径</th><th>可执行代码</th><th>hunk 落点</th></tr></thead>
    <tbody>
      {{range .Files}}
      <tr>
        <td>{{.Path}}</td>
        <td>{{if .Executable}}是{{else}}<span class="dim">否</span>{{end}}</td>
        <td class="dim">
          {{if .Hunks}}
            {{range .Hunks}}<div class="nowrap">-{{.OldStart}},{{.OldLines}} +{{.NewStart}},{{.NewLines}}</div>{{end}}
          {{else}}<span class="dim">—</span>{{end}}
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  </div>
  {{else}}<p class="note">快照没有改动文件(只有 revision 身份)。</p>{{end}}
</section>

<section>
  <h2>验证 Run 与证据</h2>
  {{if .Runs}}
    {{range .Runs}}
    <div class="cell" style="margin-bottom:8px">
      <div class="k">Run {{.ID}}</div>
      <div>
        <span class="st {{if eq .Status "pass"}}st-ok{{else if eq .Status "fail"}}st-bad{{else}}st-warn{{end}}">{{.Status}}</span>
        <span class="dim">契约 rev {{.ContractRevision}} · {{short .ContractHash}} · 环境 {{.EnvName}} · {{.Runtime}} · {{.StartedAt}} → {{.FinishedAt}}</span>
      </div>
      {{if .Evidence}}
      <div class="table-wrap">
      <table>
        <thead><tr><th>证据事实</th><th>binding / 条款</th><th>可见性</th><th>判定</th><th>记录通道</th><th>validity</th><th>时刻</th></tr></thead>
        <tbody>
          {{range .Evidence}}
          <tr>
            <td class="dim nowrap">{{short .FactID}}</td>
            <td>{{.BindingID}} <span class="dim">({{.Acceptance}})</span></td>
            <td>{{.Visibility}}</td>
            <td class="nowrap {{if eq .Verdict "pass"}}st-ok{{else if eq .Verdict "fail"}}st-bad{{else}}st-warn{{end}}">{{.Verdict}}</td>
            <td class="dim">{{.Recorder}}</td>
            <td>
              {{if .Valid}}<span class="st st-ok">valid</span>
              {{else}}<span class="st st-bad">invalidated({{.Invalidated}})</span>{{end}}
            </td>
            <td class="dim nowrap">{{.RecordedAt}}</td>
          </tr>
          {{end}}
        </tbody>
      </table>
      </div>
      {{else}}<p class="note dim">该 Run 没有证据行。</p>{{end}}
    </div>
    {{end}}
  {{else}}
  <div class="empty">该候选还没有验证 Run。<span class="do">验证 Run 是对冻结契约 × 本候选的一次实际执行(§8.13);历史 Run 全量保留,永不改写。</span></div>
  {{end}}
</section>

<section>
  <h2>确定性 Hunk 清单</h2>
  {{if .InventoryNotice}}
  <div class="flash warn">{{.InventoryNotice}}</div>
  {{end}}
  {{if .Inventory}}
  <p class="note">共 {{.FileCount}} 个改动文件、{{.HunkCount}} 个文本 hunk —— 从 Git diff 确定性重建,同一候选重算必得同一清单(§19.2 的记账分母)。</p>
  {{range .Inventory}}
  <div class="cell" style="margin-bottom:8px">
    <div class="k">{{.Path}}</div>
    <div class="dim">kind {{.Kind}} · content {{.Content}}</div>
    {{range .Hunks}}
    <div>
      <span class="dim nowrap">{{.Coord}}</span> <span class="dim nowrap">hunk {{short .ID}}</span>
      <pre style="margin:4px 0;overflow-x:auto">{{range .Body}}{{.}}
{{end}}</pre>
    </div>
    {{end}}
  </div>
  {{end}}
  {{else if not .InventoryNotice}}
  <p class="note dim">diff 为空:base 与 candidate 之间没有改动。</p>
  {{end}}
</section>

<section>
  <h2>覆盖(功能 + independence)</h2>
  {{if .Coverage.Notice}}<div class="flash warn">{{.Coverage.Notice}}</div>{{end}}
  {{if .Coverage.Available}}
  <p class="note">针对冻结契约 <span class="dim">{{short .Coverage.ContractRef}}</span> 推导;功能覆盖与 independence 覆盖是两个独立维度(§8.8.3)。</p>
  <div class="table-wrap">
  <table>
    <thead><tr><th>条款</th><th>功能覆盖</th><th>缺口 / 满足者</th><th>independence 要求</th><th>independence 覆盖</th></tr></thead>
    <tbody>
      {{range $i, $f := .Coverage.Functional}}
      <tr>
        <td>{{$f.ID}}</td>
        <td>{{if $f.Covered}}<span class="st st-ok">覆盖</span>{{else}}<span class="st st-bad">未覆盖</span>{{end}}</td>
        <td class="dim">
          {{if $f.Gap}}<div>缺口:{{$f.Gap}}</div>{{end}}
          {{if $f.SatisfiedBy}}<div>满足者:{{join $f.SatisfiedBy "、"}}</div>{{end}}
          {{if $f.Blocking}}<div>阻断 FAIL:{{join $f.Blocking "、"}}</div>{{end}}
          {{if and (not $f.Gap) (not $f.SatisfiedBy) (not $f.Blocking)}}—{{end}}
        </td>
        <td class="dim">
          {{with $ind := index $.Coverage.Independence $i}}
            {{.Required}}
          {{end}}
        </td>
        <td>
          {{with $ind := index $.Coverage.Independence $i}}
            {{if .Covered}}<span class="st st-ok">覆盖</span><div class="dim">{{join .SatisfiedBy "、"}}</div>
            {{else}}<span class="st st-bad">未覆盖</span>{{end}}
          {{end}}
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  </div>
  {{end}}
  <p><a class="btn" href="/v13/review/{{.ID}}">进入 Patch Review →</a></p>
</section>

{{end}}
{{end}}
