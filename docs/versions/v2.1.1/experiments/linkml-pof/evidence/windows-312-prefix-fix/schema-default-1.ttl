	linkml:permissible_values <https://github.com/kaicreator-mm/PENDING> , <https://github.com/kaicreator-mm/PENDING_LIMITED_EVIDENCE> .
<https://github.com/kaicreator-mm/ClaimType> skos:inScheme "https://github.com/kaicreator-mm/tally"^^xsd:anyURI ;
	linkml:definition_uri "https://github.com/kaicreator-mm/tally#ClaimType"^^xsd:anyURI ;
	linkml:permissible_values <https://github.com/kaicreator-mm/TAXONOMY_STATEMENT> .
<https://github.com/kaicreator-mm/CorpusStatus> skos:inScheme "https://github.com/kaicreator-mm/tally"^^xsd:anyURI ;
	linkml:definition_uri "https://github.com/kaicreator-mm/tally#CorpusStatus"^^xsd:anyURI ;
	linkml:permissible_values <https://github.com/kaicreator-mm/DRAFT_PENDING_HUMAN_REVIEW> .
<https://github.com/kaicreator-mm/DomainNode> a linkml:ClassDefinition ;
	skos:exactMatch "se:DomainNode"^^xsd:anyURI ;
	skos:inScheme "https://github.com/kaicreator-mm/tally"^^xsd:anyURI ;
