<https://github.com/kaicreator-mm/RelationshipPredicate> skos:inScheme "https://github.com/kaicreator-mm/tally"^^xsd:anyURI ;
	linkml:definition_uri "https://github.com/kaicreator-mm/tally#RelationshipPredicate"^^xsd:anyURI ;
	linkml:permissible_values <https://github.com/kaicreator-mm/INCLUDES> , <https://github.com/kaicreator-mm/SUPPORTED_BY> .
<https://github.com/kaicreator-mm/RelationshipStatus> skos:inScheme "https://github.com/kaicreator-mm/tally"^^xsd:anyURI ;
	linkml:definition_uri "https://github.com/kaicreator-mm/tally#RelationshipStatus"^^xsd:anyURI ;
