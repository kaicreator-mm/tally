<https://github.com/kaicreator-mm/ClaimBundle> a linkml:ClassDefinition ;
	skos:exactMatch "se:ClaimBundle"^^xsd:anyURI ;
	skos:inScheme "https://github.com/kaicreator-mm/tally"^^xsd:anyURI ;
	linkml:class_uri "https://github.com/kaicreator-mm/tally#ClaimBundle"^^xsd:anyURI ;
	linkml:definition_uri "https://github.com/kaicreator-mm/tally#ClaimBundle"^^xsd:anyURI ;
	linkml:description "A review bundle for one claim, its domain-node context and assertions." ;
	linkml:slot_usage _:c14n11 ;
	linkml:slots <https://github.com/kaicreator-mm/claim> , <https://github.com/kaicreator-mm/domain_nodes> , <https://github.com/kaicreator-mm/id> , <https://github.com/kaicreator-mm/relationship_assertions> .
