	linkml:slots <https://github.com/kaicreator-mm/corpus_status> , <https://github.com/kaicreator-mm/domain_nodes> , <https://github.com/kaicreator-mm/evidence_records> , <https://github.com/kaicreator-mm/id> , <https://github.com/kaicreator-mm/knowledge_claims> , <https://github.com/kaicreator-mm/relationship_assertions> , <https://github.com/kaicreator-mm/source_locators> , <https://github.com/kaicreator-mm/sources> , <https://github.com/kaicreator-mm/title> ;
	linkml:tree_root true .
<https://github.com/kaicreator-mm/LocatorType> skos:inScheme "https://github.com/kaicreator-mm/tally"^^xsd:anyURI ;
	linkml:definition_uri "https://github.com/kaicreator-mm/tally#LocatorType"^^xsd:anyURI ;
