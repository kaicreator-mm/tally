     se:created_on "2026-11-06" ;
     se:definition "The CS2023 Software Engineering knowledge unit \"SE-Tools: Tools and Environments\", which includes testing tools alongside software configuration management/version control, release management and process automation/continuous integration; the companion SE-Validation topics treat test tooling as spanning code coverage, static analysis, fuzzing and dynamic analysis." ;
     se:evidence_refs se:EVD-TVV-0007, se:EVD-TVV-0013 ;
     se:label "CS2023 SE-Tools Tools and Environments unit" ;
     se:lifecycle_status "PENDING_REVIEW" ;
     se:node_kind "KNOWLEDGE_UNIT" ;
     se:record_version "0.1.0" ;
     se:view_ref se:VIEW-CS2023-SE .

se:NODE-CS2023-SE-VALIDATION a se:TaxonomyNode ;
