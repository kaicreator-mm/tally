se:GAP-REQ-REAL-CASE-EVIDENCE a se:CoverageGap ;
     se:coverage_status "OPEN" ;
     se:created_on "2026-11-06" ;
     se:description "CS2023 contains no real requirements-engineering case material usable as Case or Counterexample evidence, and no case-class source (incident report, postmortem or case study touching requirements work) is registered for this scope; the lane therefore contains no Case or Counterexample records, and its pattern and anti-pattern records rest on curriculum text plus one lane-marked synthesis evidence record." ;
     se:gap_kind "SOURCE_GAP" ;
     se:impact "Pattern and AntiPattern records lack real-world illustration; the anti-pattern's counterproductive characterization remains a synthesis inference rather than an observed outcome." ;
     se:label "No real requirements-engineering case evidence" ;
     se:lifecycle_status "PROPOSED" ;
     se:record_version "0.1.0" ;
     se:resolution_notes "Register and verify at least one case-class source (for example public postmortems or requirements-related case studies) before promoting these records toward acceptance." ;
     se:severity "MEDIUM" ;
     se:target_scope_ref se:VIEW-CS2023-SE .

