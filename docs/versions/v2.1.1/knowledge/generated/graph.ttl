     se:result "The security quality-characteristic definition, the CIA property set with named additional properties, and the maintain-throughout-lifecycle expectation were confirmed." ;
     se:source_locator_ref se:LOC-07C-SWEBOK-KA13-FUNDAMENTALS ;
     se:statement "SWEBOK v4.0a KA13 section 1.1 defines security as a product quality characteristic — the degree to which a product or system protects information and data so that persons or other products have data access appropriate to their types and levels of authorization — and section 1.2 characterizes information security as preserving confidentiality, integrity and availability, with authenticity, accountability, non-repudiation and reliability possibly also involved; it states software engineers should define the security properties of their software and maintain them throughout the software development life cycle." ;
     se:synthetic "false"^^xsd:boolean .

se:EVD-07C-SWEBOK-SECURITY-REQUIREMENTS a se:Evidence ;
     se:context "SWEBOK Guide v4.0a Chapter 13 section 4.1, printed pages 13-3 to 13-4." ;
     se:created_on "2026-11-07" ;
     se:evidence_type "DIRECT_SOURCE_PARAPHRASE" ;
     se:extraction_status "EXTRACTED_PENDING_REVIEW" ;
     se:lifecycle_status "PENDING_REVIEW" ;
