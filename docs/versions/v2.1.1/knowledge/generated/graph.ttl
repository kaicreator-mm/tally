     se:source_ref se:SRC-SWEBOK-GUIDE-4-0A ;
     se:verification_state "LOCATOR_VERIFIED" ;
     se:verified_content_summary "Definition of software maintenance as the totality of activities required to provide cost-effective support for software in operation; pre-delivery and post-delivery activity stages; ISO/IEC/IEEE 14764 objective of modifying existing software while preserving its integrity." .

se:LOC-07F-SWEBOK-KA7-MAINTAINABILITY-DEBT a se:SourceLocator ;
     se:accessed_on "2026-11-07" ;
     se:created_on "2026-11-07" ;
     se:lifecycle_status "ACTIVE" ;
     se:locator "SWEBOK Guide v4.0a, Chapter 7 Software Maintenance, section 2.1.4 Maintainability; PDF page indices 171-172; printed pages 7-6 to 7-7" ;
