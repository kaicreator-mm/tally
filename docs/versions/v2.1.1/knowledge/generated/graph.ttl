se:NODE-07G-SEM-QUALITY-MANAGEMENT a se:TaxonomyNode ;
     se:PART_OF se:NODE-07G-SEM-PROJECT-PLANNING ;
     se:created_on "2026-11-07" ;
     se:definition "The quality-management subsection of SWEBOK Guide v4.0a KA9 Software Project Planning: identifying a project's software quality requirements quantitatively and/or qualitatively, setting thresholds for acceptable quality measurements per requirement, and specifying procedures for software quality assurance, verification and validation, reviews and audits during quality planning." ;
     se:evidence_refs se:EVD-07G-SWEBOK-KA9-RISK-QUALITY ;
     se:label "SWEBOK KA9 subsection 2.6: Quality Management" ;
     se:lifecycle_status "PROPOSED" ;
     se:node_kind "PRACTICE_GROUP" ;
     se:record_version "0.1.0" ;
     se:view_ref se:VIEW-07G-SWEBOK-SEM-PLANNING .

se:NODE-07G-SEM-RISK-MANAGEMENT a se:TaxonomyNode ;
     se:PART_OF se:NODE-07G-SEM-PROJECT-PLANNING ;
     se:created_on "2026-11-07" ;
     se:definition "The risk-management subsection of SWEBOK Guide v4.0a KA9 Software Project Planning: identifying risk factors, analyzing probability and potential impact, prioritizing factors and developing mitigation strategies, supported by risk-register data and revisited at intervals across the project life cycle." ;
     se:evidence_refs se:EVD-07G-SWEBOK-KA9-RISK-QUALITY ;
     se:label "SWEBOK KA9 subsection 2.5: Risk Management" ;
     se:lifecycle_status "PROPOSED" ;
     se:node_kind "PRACTICE_GROUP" ;
