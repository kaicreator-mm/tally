     se:scope_description "CS2023 SE-Validation KA Core topic 6b (curriculum authority only)." ;
     se:statement "CS2023's SE-Validation KA Core topics frame test coverage as three dimensions: test matrices, code coverage and environment coverage." .

se:CLM-TVV-0007 a se:KnowledgeClaim ;
     se:SUPPORTED_BY se:EVD-TVV-0009 ;
     se:applicability "Use when deciding where tests run in a development workflow; the curriculum frames this as a tradeoff, not a fixed rule." ;
