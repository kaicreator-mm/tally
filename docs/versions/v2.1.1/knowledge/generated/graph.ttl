se:GAP-CS2023-RIGHTS-CLEARANCE a se:CoverageGap ;
     se:coverage_status "OPEN" ;
     se:created_on "2026-11-06" ;
     se:description "The registered CS2023 permission scope expressly covers educational materials and programs and requires specific permission for other uses. Tally's general software-engineering knowledge graph is not presumed to qualify as an educational material or program; no rights clearance for broader use is asserted by this lane." ;
     se:gap_kind "REVIEW_GAP" ;
     se:impact "The lane must not claim that CS2023-derived records are cleared for public redistribution or commercial product embedding until the rights scope is confirmed." ;
