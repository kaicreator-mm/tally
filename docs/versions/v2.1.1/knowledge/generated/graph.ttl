     se:extraction_status "EXTRACTED_PENDING_REVIEW" ;
     se:lifecycle_status "PENDING_REVIEW" ;
     se:limitations "No empirical case evidence in this lane supports the severity of the anti-pattern's consequences.", "Synthesis inference, not a direct curriculum statement." ;
