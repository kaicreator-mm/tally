     se:source_ref se:SRC-SWEBOK-GUIDE-4-0A ;
     se:verification_state "LOCATOR_VERIFIED" ;
     se:verified_content_summary "ISO/IEC/IEEE 14764 maintainability definition (capability of the software product to be modified); compromised maintainability creating technical debt; accumulation under time and comprehension pressure; three in-depth investigation areas for debt." .

se:LOC-07F-SWEBOK-KA7-ORG-OBJECTIVES a se:SourceLocator ;
     se:accessed_on "2026-11-07" ;
     se:created_on "2026-11-07" ;
     se:lifecycle_status "ACTIVE" ;
     se:locator "SWEBOK Guide v4.0a, Chapter 7 Software Maintenance, section 2.2.1 Alignment with Organizational Objectives; PDF page indices 172-173; printed pages 7-7 to 7-8" ;
     se:locator_type "SECTION" ;
     se:record_version "0.1.0" ;
     se:source_ref se:SRC-SWEBOK-GUIDE-4-0A ;
     se:verification_state "LOCATOR_VERIFIED" ;
     se:verified_content_summary "New features commonly prioritized over refactoring, security or performance improvement; objectives and constraints to be balanced with maintainability and engineering standards to avoid code decay and technical debt; develop-new versus enhance-existing comparison." .

se:LOC-07F-SWEBOK-KA7-REENGINEERING a se:SourceLocator ;
     se:accessed_on "2026-11-07" ;
     se:created_on "2026-11-07" ;
     se:lifecycle_status "ACTIVE" ;
     se:locator "SWEBOK Guide v4.0a, Chapter 7 Software Maintenance, section 4.2 Software Reengineering; PDF page indices 178-179; printed pages 7-13 to 7-14" ;
     se:locator_type "SECTION" ;
     se:record_version "0.1.0" ;
     se:source_ref se:SRC-SWEBOK-GUIDE-4-0A ;
     se:verification_state "LOCATOR_VERIFIED" ;
     se:verified_content_summary "Reengineering as reconstituting software in a new form, often to replace aging legacy software; refactoring as behavior-preserving reorganization improving internal structure and maintainability; refactoring to reduce technical debt before and after code changes; continuous refactoring managing growing complexity." .

se:LOC-07F-SWEBOK-KA7-REVERSE-ENGINEERING a se:SourceLocator ;
     se:accessed_on "2026-11-07" ;
     se:created_on "2026-11-07" ;
