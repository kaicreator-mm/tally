se:REL-REQ-012 a se:RelationshipAssertion ;
     se:context "Relating the functional-specification pattern to the requirement category it must not absorb." ;
     se:created_on "2026-11-06" ;
     se:evidence_refs se:EVD-REQ-FUNCTIONAL-REQ-METHODS ;
