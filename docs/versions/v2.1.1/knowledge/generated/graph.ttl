     se:created_on "2026-11-06" ;
     se:definition "The CS2023 Software Engineering knowledge unit \"SE-Validation: Software Verification and Validation\", carrying 1 CS Core hour and 3 KA Core hours and covering verification/validation concepts, testing objectives and test kinds, test planning and coverage, test development, V&V in the development cycle, domain-specific V&V challenges, and V&V tooling topics." ;
     se:evidence_refs se:EVD-TVV-0001, se:EVD-TVV-0002 ;
     se:label "CS2023 SE-Validation Software Verification and Validation unit" ;
