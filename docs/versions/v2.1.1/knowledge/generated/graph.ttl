     se:locator_type "SECTION" ;
     se:record_version "0.1.0" ;
     se:source_ref se:SRC-SWEBOK-GUIDE-4-0A ;
     se:verification_state "LOCATOR_VERIFIED" ;
     se:verified_content_summary "Reverse engineering as passive analysis producing higher-abstraction representations; re-documentation, design recovery and data reverse engineering; visualization tooling with quality metrics, technical-debt estimation and code-smell detection." .

