     se:record_version "0.1.0" ;
     se:source_locator_ref se:LOC-NIST-218-PW7 ;
     se:statement "NIST SSDF v1.1 practice PW.7 addresses reviewing and/or analyzing human-readable code to identify vulnerabilities before release; task PW.7.1 determines whether code review (a person looks directly at the code) and/or code analysis (tools find issues in code) should be used as defined by the organization, and task PW.7.2 performs the chosen review/analysis based on the organization's secure coding standards and records and triages all discovered issues and recommended remediations in the development team's workflow or issue tracking system." ;
     se:synthetic "false"^^xsd:boolean .

