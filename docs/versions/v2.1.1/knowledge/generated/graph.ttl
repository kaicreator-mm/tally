se:NODE-CS2023-SE-PRODUCT-REQUIREMENTS a se:TaxonomyNode ;
     se:created_on "2026-11-06" ;
     se:definition "The Product Requirements knowledge unit of the CS2023 Software Engineering area, positioned by the SE Overview as introducing the processes surrounding specification of the broad requirements governing development of a new product or feature." ;
     se:evidence_refs se:EVD-REQ-SE-OVERVIEW-PRODUCT-REQUIREMENTS ;
     se:label "CS2023 SE-Requirements: Product Requirements" ;
     se:lifecycle_status "PROPOSED" ;
