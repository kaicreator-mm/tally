     se:record_version "0.1.0" ;
     se:source_ref se:SRC-SWEBOK-GUIDE-4-0A ;
     se:verification_state "LOCATOR_VERIFIED" ;
     se:verified_content_summary "Eight laws of software evolution attributed to research by Lehman and others over twenty years; maintenance as evolutionary development; large programs never complete and grow more complex unless complexity is actively reduced." .

