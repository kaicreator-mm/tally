se:NODE-CS2023-SE-SOFTWARE-DESIGN a se:TaxonomyNode ;
     se:created_on "2026-11-06" ;
     se:definition "The Software Design knowledge unit of the CS2023 Software Engineering area. Per the SE Overview, while Product Requirements focus on the user-facing functionality of a software system, Software Design focuses on the engineer-facing design of internal software components, spanning concerns as large as software architecture and choices as small as API design. Its topics cover system design principles, software architecture, programming in the large vs small and code quality indicators (CS Core), API design principles, data invariants, design models, data design and requirement traceability (KA Core), plus non-core design modeling, design-quality measurement, secure design principles and design-tradeoff evaluation." ;
     se:evidence_refs se:EVD-ARC-0009, se:EVD-ARC-0011 ;
     se:label "SE-Design Software Design CS2023 knowledge unit" ;
     se:lifecycle_status "PENDING_REVIEW" ;
     se:node_kind "KNOWLEDGE_UNIT" ;
     se:record_version "0.1.0" ;
     se:view_ref se:VIEW-CS2023-SE .

se:NODE-CS2023-SE-TOOLS a se:TaxonomyNode ;
