     se:created_on "2026-11-07" ;
     se:lifecycle_status "ACTIVE" ;
     se:locator "SWEBOK Guide v4.0a, Chapter 9 Software Engineering Management, section 2 Software Project Planning, subsections 2.5 Risk Management, 2.6 Quality Management and 2.7 Plan Management; PDF page indices 209-210; printed pages 9-9 to 9-10" ;
