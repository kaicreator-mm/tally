     se:source_ref se:SRC-SWEBOK-GUIDE-4-0A ;
     se:verification_state "LOCATOR_VERIFIED" ;
     se:verified_content_summary "Five standardized maintenance categories (corrective, preventive, adaptive, additive, perfective) regrouped by ISO/IEC/IEEE 14764 into corrections and enhancements; sixth category emergency maintenance; additive-versus-perfective distinction." .

se:LOC-07F-SWEBOK-KA7-EVOLUTION a se:SourceLocator ;
     se:accessed_on "2026-11-07" ;
     se:created_on "2026-11-07" ;
     se:lifecycle_status "ACTIVE" ;
     se:locator "SWEBOK Guide v4.0a, Chapter 7 Software Maintenance, section 1.5 Evolution of Software; PDF page indices 168-169; printed pages 7-3 to 7-4" ;
