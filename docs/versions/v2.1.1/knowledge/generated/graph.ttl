se:EVD-ARC-0010 a se:Evidence ;
     se:context "Lane-level synthesis derived only from CS2023 SE-Design KA Core topic 5a sub-topics." ;
     se:created_on "2026-11-06" ;
     se:evidence_type "SYNTHESIS" ;
     se:extraction_status "EXTRACTED_PENDING_REVIEW" ;
     se:lifecycle_status "PENDING_REVIEW" ;
     se:limitations "Inferred attribution: the anti-pattern's symptoms/causes/consequences are interpretations, not extracted source statements.", "No real-world case evidence is admitted; see the architecture and design real-case coverage gap.", "Synthesis of a curriculum teaching principle into an anti-pattern shape; CS2023 does not itself name or describe an anti-pattern." ;
     se:method "Inversion of the curriculum's stated consistency benefits into a counterproductive-structure formulation." ;
     se:record_version "0.1.0" ;
     se:result "An anti-pattern shape (inconsistent API surface) is derived without any external case evidence." ;
     se:source_locator_ref se:LOC-CS2023-SE-DESIGN-KU ;
     se:statement "Synthesis for anti-pattern formulation: because CS2023 SE-Design states that consistent APIs are easier to learn and less error-prone and that API consistency is both internal (between different portions of the API) and external (following common API patterns), an API surface whose portions follow divergent conventions or that ignores common external API patterns negates those stated benefits and is formulated here as an inconsistent API surface anti-pattern." ;
     se:synthetic "false"^^xsd:boolean ;
     se:uncertainty "Whether reviewers accept deriving an anti-pattern record from a single curriculum principle is an open review question." .

