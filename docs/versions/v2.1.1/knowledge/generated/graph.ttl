     se:lifecycle_status "PROPOSED" ;
     se:record_version "0.1.0" ;
     se:resolution_notes "Obtain a documented rights determination or specific permission before public redistribution or commercial product embedding; otherwise replace the source or remove the affected records from those uses." ;
     se:severity "HIGH" ;
     se:target_scope_ref se:DOMAIN-SOFTWARE-ENGINEERING .

