{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kaicreator-mm/tally/docs/versions/v2.1.2/knowledge/model/source-owner-disposition.schema.json",
  "title": "Tally v2.1.2 SourceOwnerDisposition",
  "description": "A Source Owner scoped disposition, separate from ReviewDecision and Claim lifecycle acceptance. ACTIVE records bind exact original and candidate record revisions; changed bindings are STALE and fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@id",
    "@type",
    "se:record_version",
    "se:lifecycle_status",
    "se:created_on",
    "se:claim_ref",
    "se:claim_record_version",
    "se:claim_digest_sha256",
    "se:evidence_ref",
    "se:evidence_record_version",
    "se:evidence_digest_sha256",
    "se:original_locator_ref",
    "se:original_locator_record_version",
    "se:original_locator_digest_sha256",
    "se:candidate_locator_ref",
    "se:candidate_locator_record_version",
    "se:candidate_locator_digest_sha256",
    "se:source_ref",
    "se:source_owner_login",
    "se:source_owner_ref",
    "se:source_owner_authority_ref",
    "se:source_owner_authority_type",
    "se:disposition",
    "se:scope",
    "se:positive",
    "se:negative",
    "se:unknown",
    "se:rights_scope",
    "se:publication_permission",
    "se:professional_oracle_status",
    "se:independent_educational_review_ref",
    "se:taxonomy_node_ref",
    "se:candidate_element_attribution",
    "se:candidate_element_status",
    "se:claim_lifecycle_effect"
  ],
  "properties": {
    "@id": {
      "type": "string",
      "pattern": "^se:SOD-[A-Z0-9][A-Z0-9._-]*$"
    },
    "@type": {
      "const": "se:SourceOwnerDisposition"
    },
    "se:record_version": {
      "$ref": "#/$defs/version"
    },
    "se:lifecycle_status": {
      "type": "string",
      "enum": ["ACTIVE", "SUPERSEDED", "RETRACTED", "WITHDRAWN"]
    },
    "se:created_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "se:claim_ref": {
      "$ref": "#/$defs/ref"
    },
    "se:claim_record_version": {
      "$ref": "#/$defs/version"
    },
    "se:claim_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "se:evidence_ref": {
      "$ref": "#/$defs/ref"
    },
    "se:evidence_record_version": {
      "$ref": "#/$defs/version"
    },
    "se:evidence_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "se:original_locator_ref": {
      "$ref": "#/$defs/ref"
    },
    "se:original_locator_record_version": {
      "$ref": "#/$defs/version"
    },
    "se:original_locator_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "se:candidate_locator_ref": {
      "$ref": "#/$defs/ref"
    },
    "se:candidate_locator_record_version": {
      "$ref": "#/$defs/version"
    },
    "se:candidate_locator_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "se:source_ref": {
      "$ref": "#/$defs/ref"
    },
    "se:source_owner_login": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "se:source_owner_ref": {
      "$ref": "#/$defs/ref"
    },
    "se:source_owner_authority_ref": {
      "$ref": "#/$defs/ref"
    },
    "se:source_owner_authority_type": {
      "type": "string",
      "enum": ["PROJECT_OWNER_DELEGATED_EXECUTION_NOT_PERSONAL_LINE_BY_LINE_ATTESTATION", "DIRECT_SOURCE_OWNER"]
    },
    "se:disposition": {
      "type": "string",
      "enum": ["ACCEPT_SCOPED_FOR_VERSIONED_CANDIDATE", "REWORK_REQUIRED", "UNKNOWN", "EXCLUDED"]
    },
    "se:scope": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "se:positive": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "se:negative": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "se:unknown": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "se:rights_scope": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "se:publication_permission": {
      "const": "NOT_GRANTED_BY_THIS_OWNER_DECISION"
    },
    "se:professional_oracle_status": {
      "type": "string",
      "enum": ["NOT_ATTESTED", "ATTESTED_BY_DISTINCT_SEMANTIC_REVIEW"]
    },
    "se:professional_oracle_ref": {
      "$ref": "#/$defs/ref"
    },
    "se:independent_educational_review_ref": {
      "$ref": "#/$defs/ref"
    },
    "se:taxonomy_node_ref": {
      "$ref": "#/$defs/ref"
    },
    "se:candidate_element_attribution": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "se:candidate_element_status": {
      "const": "CANDIDATE_ATTRIBUTION_ONLY_NOT_SAP_GLOBAL_ROOT_R8"
    },
    "se:claim_lifecycle_effect": {
      "const": "NONE_ORIGINAL_AND_CANDIDATE_CLAIM_REMAIN_PENDING"
    },
    "se:supersedes_ref": {
      "$ref": "#/$defs/ref"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@id"],
      "properties": {
        "@id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  },
  "x-version-evolution": "A revised disposition uses a new SOD event id, increments record_version and names supersedes_ref. The superseded event must not remain ACTIVE. At most one ACTIVE disposition may bind a Claim. Every ACTIVE binding must equal the current exact target record_version and canonical SHA-256; otherwise it is STALE and invalid.",
  "x-review-separation": "SourceOwnerDisposition is not ReviewDecision. It cannot set Claim review_status=ACCEPTED or lifecycle_status=ACCEPTED, and cannot substitute for a distinct professional semantic Oracle or publisher permission."
}
